{
  "name": "awad-LeeTKOB-backend",
  "version": "1.0.50",
  "scripts": {
    "generate": "npx drizzle-kit generate",
    "migrate": "npx drizzle-kit migrate",
    "seed": "bun run src/db/seed.ts",
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elysia/html": "^1.4.1",
    "@elysia/openapi": "^2.0.0-rc.1",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^1.0.0-rc.5",
    "elysia": "^2.0.0-rc.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/pg": "^8.23.1",
    "bun-types": "latest",
    "drizzle-kit": "^1.0.0-rc.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "module": "src/index.js"
}

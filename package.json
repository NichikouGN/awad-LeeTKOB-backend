{
  "name": "awad-LeeTKOB-backend",
  "version": "1.0.50",
  "scripts": {
    "db:generate": "npx drizzle-kit generate",
    "db:migrate": "npx drizzle-kit migrate",
    "db:seed": "bun run src/db/seed.ts",
    "db:start": "docker compose down -v && docker compose up -d && sleep 5 && bun run db:migrate && bun run db:seed",
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "lint": "biome lint .",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\" \".prettierrc.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\" \".prettierrc.json\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elysia/html": "^1.4.1",
    "@elysia/jwt": "^2.0.0-rc.0",
    "@elysia/openapi": "^2.0.0-rc.1",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^1.0.0-rc.5",
    "elysia": "^2.0.0-rc.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/pg": "^8.23.1",
    "bun-types": "latest",
    "drizzle-kit": "^1.0.0-rc.5",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "module": "src/index.js"
}

DATABASE_URL=postgres://postgres:postgres@localhost:5432/mydb
JWT_ACCESS_TOKEN=replace-with-a-random-access-secret
JWT_REFRESH_TOKEN=replace-with-a-random-refresh-secret
REDIS_URL=redis://127.0.0.1:6379
JUDGE_SANDBOX_IMAGE=leetkob-cpp-sandbox:local
JUDGE_CONCURRENCY=2
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Keep 1 for offline/model-free checks. Set 0 after adding your own server-side key.
MODEL_OFF=1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BILLING_TIER=free
MODEL_TIMEOUT_MS=10000
MODEL_LAB_BUDGET_USD=1.00
